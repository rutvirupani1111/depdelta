{
  "name": "depdelta",
  "version": "0.1.0",
  "description": "See what your dependency updates can suddenly do. Diffs the capabilities (network, env reads, child processes, install scripts, obfuscation) of every package that changed in your lockfile.",
  "keywords": [
    "supply-chain",
    "security",
    "npm",
    "lockfile",
    "dependencies",
    "capabilities",
    "malware",
    "install-scripts",
    "sarif",
    "github-action",
    "pnpm",
    "yarn"
  ],
  "license": "MIT",
  "author": "Rutvi Rupani",
  "type": "module",
  "bin": {
    "depdelta": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutvirupani1111/depdelta.git"
  },
  "homepage": "https://github.com/rutvirupani1111/depdelta#readme",
  "bugs": {
    "url": "https://github.com/rutvirupani1111/depdelta/issues"
  }
}
